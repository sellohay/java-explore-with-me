              "});\r",
              "\r",
              "pm.test(\"Ответ должен содержать тело в формате JSON\", function () {\r",
              "    pm.response.to.be.withBody;\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"В теле ответа должна быть RatingDto\", function () {\r",
              "    const body = pm.response.json();\r",
